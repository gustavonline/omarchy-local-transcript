def desktop_entry_paths() -> list[Path]:
    roots = [XDG_DATA_HOME / "applications"]
    roots.extend(Path(value) / "applications" for value in os.environ.get(
        "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if value)
    paths: list[Path] = []
    seen: set[str] = set()
    for root in roots:
        if not root.is_dir():
            continue
        for path in sorted(root.glob("*.desktop")):
            identity = path.name.casefold()
            if identity not in seen:
                seen.add(identity)
                paths.append(path)
    return paths


def executable_from_desktop(exec_line: str) -> tuple[str, str]:
    try:
        parts = shlex.split(exec_line)
    except ValueError:
        parts = exec_line.split()
    parts = [part for part in parts if not re.fullmatch(r"%[A-Za-z]", part)]
    url = next((part for part in parts if part.startswith(("http://", "https://"))), "")
    command = ""
    for part in parts:
        if part == "env" or "=" in part and not part.startswith("/"):
            continue
        command = Path(part).name
        break
    return command, url


def installed_apps() -> list[dict]:
    apps: list[dict] = []
    ignored_tokens = {
        "application", "desktop", "launch", "launcher", "omarchy", "webapp",
        "handler", "https", "http", "www", "com", "org", "bin", "usr",
    }
    for path in desktop_entry_paths():
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.optionxform = str
        try:
            parser.read(path, encoding="utf-8")
            entry = parser["Desktop Entry"]
        except (OSError, KeyError, configparser.Error):
            continue
        if entry.get("Type", "Application") != "Application":
            continue
        if entry.get("Hidden", "false").lower() == "true" or entry.get("NoDisplay", "false").lower() == "true":
            continue
        name = clean(entry.get("Name", ""))
        if not name:
            continue
        desktop_id = path.stem
        startup_class = clean(entry.get("StartupWMClass", ""))
        executable, url = executable_from_desktop(entry.get("Exec", ""))
        host = urllib.parse.urlparse(url).hostname or ""
        candidates = [desktop_id, name, startup_class, executable, host]
        tokens: set[str] = set()
        for candidate in candidates:
            normalized = candidate.casefold().replace("_", " ").replace("-", " ")
            if len(normalized.strip()) >= 3:
                tokens.add(normalized.strip())
            for part in re.findall(r"[\w.]+", normalized, flags=re.UNICODE):
                bare = part.strip(".")
                if len(bare) >= 3 and bare not in ignored_tokens:
                    tokens.add(bare)
        description = host.removeprefix("www.") if host else startup_class or executable or desktop_id
        apps.append({
            "value": desktop_id,
            "label": name,
            "description": description,
            "tokens": sorted(tokens, key=lambda value: (-len(value), value)),
        })
    return sorted(apps, key=lambda app: (app["label"].casefold(), app["value"].casefold()))


def app_options() -> None:
    print(json.dumps([
        {"value": app["value"], "label": app["label"], "description": app["description"]}
        for app in installed_apps()
    ], ensure_ascii=False))


def audio_clients(kind: str) -> list[dict]:
    """Return active recording or playback clients from PipeWire's PulseAudio view."""
    target = "source-outputs" if kind == "recording" else "sink-inputs"
    result = run([PACTL, "--format=json", "list", target], check=False, timeout=8)
    if result.returncode != 0:
        return []
    try:
        items = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    clients = []
    for item in items if isinstance(items, list) else []:
        if item.get("mute") is True or item.get("corked") is True:
            continue
        properties = item.get("properties") if isinstance(item.get("properties"), dict) else {}
        haystack = " ".join(str(value) for value in properties.values()).casefold()
        if any(token in haystack for token in ("voxtype", "local-transcript", "local-meeting", "ffmpeg")):
            continue
        clients.append({"properties": properties, "haystack": haystack, "kind": kind})
    return clients


def application_windows() -> list[str]:
    if not command_exists(HYPRCTL):
        return []
    result = run([HYPRCTL, "clients", "-j"], check=False, timeout=8)
    if result.returncode != 0:
        return []
    try:
        clients = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    windows = []
    for item in clients if isinstance(clients, list) else []:
        if not isinstance(item, dict):
            continue
        values = [item.get("class", ""), item.get("initialClass", ""),
                  item.get("title", ""), item.get("initialTitle", "")]
        windows.append(" ".join(str(value) for value in values).casefold())
    return windows


def detect_source_app(config: dict) -> str:
    selected = set(config.get("sourceApps", []))
    if not selected:
        return ""
    apps = [app for app in installed_apps() if app["value"] in selected]
    if not apps:
        return ""
    recording = audio_clients("recording")
    playback = audio_clients("playback")
    clients = recording + playback
    for app in apps:
        if any(any(token in client["haystack"] for token in app["tokens"]) for client in clients):
            return app["label"]
    if not clients:
        return ""
    windows = application_windows()
    for app in apps:
        if any(any(token in window for token in app["tokens"]) for window in windows):
            return app["label"]
    return ""


def detect() -> None:
    config = load_config()
    if not config.get("configured") or not config.get("detectSources", True):
        print(json.dumps({"detected": False}))
        return
    if runtime_meeting()[0] != "idle":
        print(json.dumps({"detected": False, "reason": "already-recording"}))
        return
    app = detect_source_app(config)
    detection_path = DATA_DIR / "detection.json"
    state_value = read_json(detection_path, {})
    detection = state_value if isinstance(state_value, dict) else {}
    now = int(time.time())
    if not app:
        if detection.get("candidate"):
            atomic_json(detection_path, {"candidate": "", "count": 0, "last_notified": detection.get("last_notified", 0)})
        print(json.dumps({"detected": False}))
        return

    count = int(detection.get("count", 0)) + 1 if detection.get("candidate") == app else 1
    last_notified = int(detection.get("last_notified", 0) or 0)
    detection.update({"candidate": app, "count": count})
    atomic_json(detection_path, detection)
    if count < 2 or now - last_notified < 1800:
        print(json.dumps({"detected": True, "app": app, "notified": False}))
        return

    detection["last_notified"] = now
    atomic_json(detection_path, detection)
    action = ""
    if command_exists(NOTIFY_SEND):
        result = run([
            NOTIFY_SEND,
            "--app-name=Local Transcript",
            "--icon=text-x-generic",
            "--urgency=normal",
            "--expire-time=15000",
            "--action=open=Open Local Transcript",
            "--action=dismiss=Not now",
            "Audio source detected",
            f"{app} is using audio. Start a local transcript?",
        ], check=False, timeout=60)
        action = result.stdout.strip()
    if action == "open" and command_exists(OMARCHY_SHELL):
        run([OMARCHY_SHELL, "-q", "io.github.gustavonline.local-transcript", "toggle"], check=False, timeout=10)
    print(json.dumps({"detected": True, "app": app, "notified": True, "action": action}))


def main() -> None:
    os.umask(0o077)
    command = sys.argv[1] if len(sys.argv) > 1 else "state"
    if command == "state":
        state()
    elif command == "setup-state":
        setup_state()
    elif command == "configure":
        if len(sys.argv) != 9:
            raise ValueError("Usage: local-transcript configure DIR STT SUMMARY SAVE_AUDIO AUTO_SUMMARIZE DETECT APPS")
        configure(*sys.argv[2:9])
    elif command == "download-stt":
        download_stt(sys.argv[2])
    elif command == "download-summary":
        download_summary(sys.argv[2])
    elif command == "start":
        start_meeting(sys.argv[2] if len(sys.argv) > 2 else "")
    elif command in {"pause", "resume"}:
        control(command)
    elif command == "stop":
        stop_meeting()
    elif command == "add-note":
        if len(sys.argv) != 4:
            raise ValueError("Usage: local-transcript add-note AUTHOR NOTE")
        write_note(sys.argv[2], sys.argv[3])
    elif command == "open":
        open_target()
    elif command == "detect":
        detect()
    elif command == "apps":
        app_options()
    else:
        raise ValueError(f"Unknown command: {command}")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
