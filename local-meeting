def microphone_clients() -> list[dict]:
    """Return active microphone consumers from PipeWire's PulseAudio view."""
    result = run([PACTL, "--format=json", "list", "source-outputs"], check=False, timeout=8)
    if result.returncode != 0:
        return []
    try:
        items = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    clients = []
    for item in items if isinstance(items, list) else []:
        if item.get("mute") is True or item.get("corked") is True:
            continue
        properties = item.get("properties") if isinstance(item.get("properties"), dict) else {}
        haystack = " ".join(str(value) for value in properties.values()).lower()
        if any(token in haystack for token in ("voxtype", "local-meeting", "ffmpeg")):
            continue
        clients.append({"properties": properties, "haystack": haystack})
    return clients


def meeting_windows() -> str:
    if not command_exists(HYPRCTL):
        return ""
    result = run([HYPRCTL, "clients", "-j"], check=False, timeout=8)
    if result.returncode != 0:
        return ""
    try:
        clients = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return ""
    values = []
    for item in clients if isinstance(clients, list) else []:
        if not isinstance(item, dict):
            continue
        values.extend([item.get("class", ""), item.get("initialClass", ""),
                       item.get("title", ""), item.get("initialTitle", "")])
    return " ".join(str(value) for value in values).lower()


def detect_meeting_app(config: dict) -> str:
    clients = microphone_clients()
    if not clients:
        return ""
    enabled = set(config.get("detectionApps", default_config()["detectionApps"]))
    direct_apps = [
        ("zoom", "zoom", "Zoom"),
        ("teams", "microsoft teams", "Microsoft Teams"),
        ("teams", "teams", "Microsoft Teams"),
        ("discord", "discord", "Discord"),
        ("discord", "vesktop", "Discord / Vesktop"),
        ("discord", "webcord", "Discord / WebCord"),
        ("slack", "slack", "Slack"),
        ("buzz", "buzz", "Buzz"),
        ("webex", "webex", "Webex"),
        ("jitsi", "jitsi", "Jitsi"),
    ]
    for client in clients:
        for app_id, token, label in direct_apps:
            if app_id in enabled and token in client["haystack"]:
                return label

    windows = meeting_windows()
    window_apps = [
        ("meet", "meet.google", "Google Meet"),
        ("meet", "google meet", "Google Meet"),
        ("slack", "slack huddle", "Slack Huddle"),
        ("teams", "microsoft teams", "Microsoft Teams"),
        ("zoom", "zoom meeting", "Zoom"),
        ("discord", "discord", "Discord"),
        ("browser", "whereby", "Whereby"),
        ("jitsi", "jitsi meet", "Jitsi"),
    ]
    for app_id, token, label in window_apps:
        if app_id in enabled and token in windows:
            return label

    browser_tokens = ("chromium", "chrome", "brave", "firefox", "zen", "vivaldi", "edge")
    if "browser" in enabled and any(any(token in client["haystack"] for token in browser_tokens) for client in clients):
        return "Browser call"

    custom_tokens = [part.strip().lower() for part in str(config.get("customMeetingApps", "")).split(",") if part.strip()]
    combined = windows + " " + " ".join(client["haystack"] for client in clients)
    for token in custom_tokens:
        if token in combined:
            return token
    return ""


def detect() -> None:
    config = load_config()
    if not config.get("configured") or not config.get("detectMeetings", True):
        print(json.dumps({"detected": False}))
        return
    if runtime_meeting()[0] != "idle":
        print(json.dumps({"detected": False, "reason": "already-recording"}))
        return
    app = detect_meeting_app(config)
    detection_path = DATA_DIR / "detection.json"
    state_value = read_json(detection_path, {})
    detection = state_value if isinstance(state_value, dict) else {}
    now = int(time.time())
    if not app:
        if detection.get("candidate"):
            atomic_json(detection_path, {"candidate": "", "count": 0, "last_notified": detection.get("last_notified", 0)})
        print(json.dumps({"detected": False}))
        return

    count = int(detection.get("count", 0)) + 1 if detection.get("candidate") == app else 1
    last_notified = int(detection.get("last_notified", 0) or 0)
    detection.update({"candidate": app, "count": count})
    atomic_json(detection_path, detection)
    if count < 2 or now - last_notified < 1800:
        print(json.dumps({"detected": True, "app": app, "notified": False}))
        return

    detection["last_notified"] = now
    atomic_json(detection_path, detection)
    action = ""
    if command_exists(NOTIFY_SEND):
        result = run([
            NOTIFY_SEND,
            "--app-name=Local Meeting",
            "--icon=audio-input-microphone",
            "--urgency=normal",
            "--expire-time=15000",
            "--action=open=Open Local Meeting",
            "--action=dismiss=Not now",
            "Meeting detected",
            f"{app} is using your microphone. Start local recording and notes?",
        ], check=False, timeout=60)
        action = result.stdout.strip()
    if action == "open" and command_exists(OMARCHY_SHELL):
        run([OMARCHY_SHELL, "-q", "io.github.gustavonline.local-meeting", "toggle"], check=False, timeout=10)
    print(json.dumps({"detected": True, "app": app, "notified": True, "action": action}))


def main() -> None:
    os.umask(0o077)
    command = sys.argv[1] if len(sys.argv) > 1 else "state"
    if command == "state":
        state()
    elif command == "setup-state":
        setup_state()
    elif command == "configure":
        if len(sys.argv) != 11:
            raise ValueError("Usage: local-meeting configure DIR STT SUMMARY LANGUAGE SAVE_AUDIO AUTO_SUMMARIZE DETECT APPS CUSTOM")
        configure(*sys.argv[2:11])
    elif command == "download-stt":
        download_stt(sys.argv[2])
    elif command == "download-summary":
        download_summary(sys.argv[2])
    elif command == "start":
        start_meeting(sys.argv[2] if len(sys.argv) > 2 else "")
    elif command in {"pause", "resume"}:
        control(command)
    elif command == "stop":
        stop_meeting()
    elif command == "add-note":
        if len(sys.argv) != 4:
            raise ValueError("Usage: local-meeting add-note AUTHOR NOTE")
        write_note(sys.argv[2], sys.argv[3])
    elif command == "open":
        open_target()
    elif command == "detect":
        detect()
    else:
        raise ValueError(f"Unknown command: {command}")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
